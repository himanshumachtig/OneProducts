{#
/**
 * @file
 * Wishlist page — items rendered from localStorage by wishlist.js.
 */
#}
{{ attach_library('commerce_theme/wishlist') }}

<div id="page-wrapper">

  {% include directory ~ '/templates/layout/partials/site-header.html.twig' %}

  <main id="main-content" role="main">

    <div class="container-fluid page-header py-5">
      <h1 class="text-center text-white display-6">{{ 'My Wishlist'|t }}</h1>
      <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/">{{ 'Home'|t }}</a></li>
        <li class="breadcrumb-item active text-white">{{ 'Wishlist'|t }}</li>
      </ol>
    </div>

    <div class="container py-5">
      <div class="row" id="wishlist-page-items">
        <div class="col-12 text-center py-5">
          <i class="far fa-heart" style="font-size:4rem;color:#dee2e6;"></i>
          <h4 class="mt-3 text-muted">{{ 'Loading…'|t }}</h4>
        </div>
      </div>
    </div>

  </main>

  {% include directory ~ '/templates/layout/partials/site-footer.html.twig' %}

</div>
