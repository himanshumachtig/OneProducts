{#
/**
 * @file page--user--register.html.twig
 * User registration page.
 */
#}

{# ── Loading spinner ── #}
<div id="spinner"
     class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center"
     style="z-index:9999;">
  <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
    <span class="visually-hidden">{{ 'Loading...'|t }}</span>
  </div>
</div>

<div id="page-wrapper">

  {% include directory ~ '/templates/layout/partials/site-header.html.twig' %}

  <main id="main-content" role="main">

    <div class="container-fluid page-header py-5">
      <h1 class="text-center text-white display-6">{{ 'Create Account'|t }}</h1>
      <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="{{ path('<front>') }}">{{ 'Home'|t }}</a></li>
        <li class="breadcrumb-item active text-white">{{ 'Register'|t }}</li>
      </ol>
    </div>

    <div class="highlighted">{{ page.highlighted }}</div>

    <div class="container py-5 my-3">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
          <div class="card border-0 shadow-sm rounded-4 p-2">
            <div class="card-body p-4">
              <div class="text-center mb-4">
                <div class="rounded-circle bg-success d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:65px;height:65px;">
                  <i class="fas fa-user-plus fa-2x text-white"></i>
                </div>
                <h3 class="fw-bold">{{ 'Join Us'|t }}</h3>
                <p class="text-muted">{{ 'Create a free account to start shopping'|t }}</p>
              </div>
              <div class="bg-light rounded p-3 mb-4">
                <ul class="list-unstyled mb-0">
                  <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>{{ 'Track your orders'|t }}</li>
                  <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>{{ 'Save your wishlist'|t }}</li>
                  <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>{{ 'Faster checkout'|t }}</li>
                  <li><i class="fas fa-check-circle text-success me-2"></i>{{ 'Exclusive deals'|t }}</li>
                </ul>
              </div>
              <div class="register-form-wrapper">
                {{ page.content }}
              </div>
              <hr class="my-4">
              <div class="text-center">
                <p class="mb-2">{{ 'Already have an account?'|t }}</p>
                <a href="/user/login" class="btn btn-outline-primary rounded-pill px-4">
                  {{ 'Sign In'|t }}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </main>

  {% include directory ~ '/templates/layout/partials/site-footer.html.twig' %}

</div>
