{#
/**
 * @file page--user--password.html.twig
 * Password reset request page.
 */
#}
{{ attach_library('commerce_theme/user-password') }}

<div id="page-wrapper">

  {% include directory ~ '/templates/layout/partials/site-header.html.twig' %}

  <main id="main-content" role="main">

    <div class="container-fluid page-header py-5">
      <h1 class="text-center text-white display-6">{{ 'Reset Password'|t }}</h1>
      <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="{{ path('<front>') }}">{{ 'Home'|t }}</a></li>
        <li class="breadcrumb-item active text-white">{{ 'Reset Password'|t }}</li>
      </ol>
    </div>

    <div class="container py-5 my-3">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
          <div class="card border-0 shadow-sm rounded-4 p-2">
            <div class="card-body p-4">

              <div class="text-center mb-4">
                <div class="rounded-circle bg-warning d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:65px;height:65px;">
                  <i class="fas fa-key fa-2x text-white"></i>
                </div>
                <h4 class="fw-bold">{{ 'Forgot your password?'|t }}</h4>
                <p class="text-muted small">{{ 'Enter your email address and we\'ll send you a reset link.'|t }}</p>
              </div>

              {# Email input + real-time check #}
              <div class="mb-3">
                <label for="reset-email-input" class="form-label fw-semibold">
                  {{ 'Email Address'|t }}
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0">
                    <i class="fas fa-envelope text-muted"></i>
                  </span>
                  <input type="email"
                         id="reset-email-input"
                         class="form-control border-start-0 ps-0"
                         placeholder="{{ 'your@email.com'|t }}"
                         autocomplete="email"
                         style="border-radius:0 .5rem .5rem 0;">
                </div>
                {# Status message shown in real-time #}
                <div id="reset-email-status" class="mt-2" style="min-height:24px;font-size:.87rem;"></div>
              </div>

              {# Hidden Drupal form — synced from input above #}
              <div style="display:none;" id="drupal-pass-form-wrapper">
                {{ page.content }}
              </div>

              {# Send reset link button #}
              <button type="button"
                      id="reset-send-btn"
                      class="btn btn-warning w-100 rounded-pill fw-bold py-3 mt-2"
                      disabled>
                <i class="fas fa-paper-plane me-2"></i>{{ 'Send Reset Link'|t }}
              </button>

              <hr class="my-4">
              <div class="text-center">
                <a href="/user/login" class="text-muted text-decoration-none">
                  <i class="fas fa-arrow-left me-1"></i>{{ 'Back to Login'|t }}
                </a>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>

  </main>

  {% include directory ~ '/templates/layout/partials/site-footer.html.twig' %}

</div>
