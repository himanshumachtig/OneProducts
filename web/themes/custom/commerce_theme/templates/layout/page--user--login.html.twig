{#
/**
 * @file page--user--login.html.twig
 * User login page.
 */
#}

{# ── Loading spinner ── #}
<div id="spinner"
     class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center"
     style="z-index:9999;">
  <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
    <span class="visually-hidden">{{ 'Loading...'|t }}</span>
  </div>
</div>

<div id="page-wrapper">

  {% include directory ~ '/templates/layout/partials/site-header.html.twig' %}

  <main id="main-content" role="main">

    <div class="container-fluid page-header py-5">
      <h1 class="text-center text-white display-6">{{ 'Login'|t }}</h1>
      <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="{{ path('<front>') }}">{{ 'Home'|t }}</a></li>
        <li class="breadcrumb-item active text-white">{{ 'Login'|t }}</li>
      </ol>
    </div>

    <div class="container py-5 my-3">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
          <div class="card border-0 shadow-sm rounded-4 p-2">
            <div class="card-body p-4">
              <div class="text-center mb-4">
                <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:65px;height:65px;">
                  <i class="fas fa-user fa-2x text-white"></i>
                </div>
                <h3 class="fw-bold">{{ 'Welcome Back'|t }}</h3>
                <p class="text-muted">{{ 'Sign in to your account'|t }}</p>
              </div>
              {# Google login button #}
              <a href="/user/login/google"
                 class="btn btn-outline-dark w-100 rounded-pill py-2 mb-3 d-flex align-items-center justify-content-center gap-2">
                <svg width="20" height="20" viewBox="0 0 48 48">
                  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                  <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                {{ 'Continue with Google'|t }}
              </a>

              <div class="d-flex align-items-center gap-2 mb-3">
                <hr class="flex-grow-1 m-0">
                <span class="text-muted small">{{ 'or sign in with email'|t }}</span>
                <hr class="flex-grow-1 m-0">
              </div>

              <div class="login-form-wrapper">
                {{ page.content }}
              </div>

              {# Forgot / Reset password #}
              <div class="text-center mt-3 mb-1">
                <a href="/user/password" class="reset-password-link">
                  <i class="fas fa-lock-open me-1"></i>{{ 'Forgot your password?'|t }}
                </a>
              </div>

              <hr class="my-4">
              <div class="text-center">
                <p class="mb-2">{{ "Don't have an account?"|t }}</p>
                <a href="/user/register" class="btn btn-outline-primary rounded-pill px-4">
                  {{ 'Create Account'|t }}
                </a>
              </div>
            </div>
          </div>
          <div class="d-flex justify-content-center gap-4 mt-4 text-muted">
            <span><i class="fas fa-lock me-1 text-primary"></i>{{ 'Secure login'|t }}</span>
            <span><i class="fas fa-shield-alt me-1 text-primary"></i>{{ 'SSL protected'|t }}</span>
          </div>
        </div>
      </div>
    </div>

  </main>

  {% include directory ~ '/templates/layout/partials/site-footer.html.twig' %}

</div>
