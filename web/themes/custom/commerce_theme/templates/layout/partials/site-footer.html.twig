{#
/**
 * @file partials/site-footer.html.twig
 * Site footer — included by all page templates.
 *
 * Drupal regions rendered:
 *   page.footer_top   — optional footer info / newsletter blocks (admin-managed).
 *   page.footer_menu  — footer navigation menu (place Footer menu block here).
 *   page.footer_bottom — optional copyright / bottom-bar blocks.
 *
 * Static content (contact info, social links) can be replaced by Custom Blocks
 * placed in the footer_top region via Admin → Structure → Block Layout.
 */
#}

<footer id="footer" role="contentinfo">

  {# ══════════════════════════════════════════════════════════════════
     FOOTER TOP REGION
     Place contact-info blocks, newsletter signup, etc. here via Block Layout.
     Falls back to hardcoded contact columns when no blocks are placed.
     ══════════════════════════════════════════════════════════════════ #}
  <div class="container-fluid footer py-5">
    <div class="container py-5">

      {% if page.footer_top %}
        {# Admin-managed footer content #}
        {{ page.footer_top }}

      {% else %}
        {# ── Default contact strip (edit via Block Layout when ready) ── #}
        <div class="row g-4 rounded mb-5" style="background:rgba(255,255,255,.03);">
          {% for col in [
            {'icon': 'fa-map-marker-alt', 'title': 'Address',   'text': '123 Street, New York, USA'},
            {'icon': 'fa-envelope',       'title': 'Mail Us',   'text': 'info@example.com'},
            {'icon': 'fa-phone-alt',      'title': 'Telephone', 'text': '(+012) 3456 7890'},
            {'icon': 'fa-globe',          'title': 'Website',   'text': 'www.example.com'}
          ] %}
            <div class="col-md-6 col-xl-3">
              <div class="rounded p-4">
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mb-4"
                     style="width:70px;height:70px;">
                  <i class="fa {{ col.icon }} fa-2x text-primary"></i>
                </div>
                <h5 class="text-white">{{ col.title|t }}</h5>
                <p class="mb-0 text-muted">{{ col.text }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {# ── Footer columns: newsletter + nav menu ── #}
      {# All four columns live in ONE flat row so Bootstrap grid works correctly #}
      <div class="row g-5">

        {# Newsletter column #}
        <div class="col-md-6 col-lg-3">
          <div class="footer-item d-flex flex-column">
            <h4 class="text-primary mb-4">{{ 'Newsletter'|t }}</h4>
            <p class="text-white mb-3">{{ 'Subscribe for the latest deals and updates.'|t }}</p>
            <div class="position-relative mx-auto w-100">
              <input class="form-control rounded-pill w-100 py-3 ps-4 pe-5"
                     type="email"
                     placeholder="{{ 'Enter your email'|t }}"
                     aria-label="{{ 'Email address'|t }}">
              <button type="button"
                      class="btn btn-primary rounded-pill position-absolute top-0 end-0 py-2 mt-2 me-2">
                {{ 'Sign Up'|t }}
              </button>
            </div>
          </div>
        </div>

        {# Footer menu columns — rendered directly into this row.
           menu--footer.html.twig outputs col-md-6 col-lg-3 divs.
           Fallback hardcoded cols shown when no block is placed. #}
        {% if page.footer_menu %}
          {{ page.footer_menu }}
        {% else %}
          <div class="col-md-6 col-lg-3">
            <div class="footer-item d-flex flex-column">
              <h4 class="text-primary mb-4">{{ 'Customer Service'|t }}</h4>
              <a href="/contact"><i class="fas fa-angle-right me-2"></i>{{ 'Contact Us'|t }}</a>
              <a href="/user"><i class="fas fa-angle-right me-2"></i>{{ 'My Account'|t }}</a>
              <a href="{{ path('commerce_cart.page') }}"><i class="fas fa-angle-right me-2"></i>{{ 'Shopping Cart'|t }}</a>
            </div>
          </div>
          <div class="col-md-6 col-lg-3">
            <div class="footer-item d-flex flex-column">
              <h4 class="text-primary mb-4">{{ 'Shop'|t }}</h4>
              <a href="/products"><i class="fas fa-angle-right me-2"></i>{{ 'All Products'|t }}</a>
              <a href="/products?field_category_target_id=1"><i class="fas fa-angle-right me-2"></i>{{ 'Electronics'|t }}</a>
            </div>
          </div>
          <div class="col-md-6 col-lg-3">
            <div class="footer-item d-flex flex-column">
              <h4 class="text-primary mb-4">{{ 'Information'|t }}</h4>
              <a href="/about"><i class="fas fa-angle-right me-2"></i>{{ 'About Us'|t }}</a>
              <a href="/privacy-policy"><i class="fas fa-angle-right me-2"></i>{{ 'Privacy Policy'|t }}</a>
              <a href="/terms"><i class="fas fa-angle-right me-2"></i>{{ 'Terms & Conditions'|t }}</a>
            </div>
          </div>
        {% endif %}

      </div>{# /.row g-5 #}
    </div>{# /.container #}
  </div>

  {# ══════════════════════════════════════════════════════════════════
     COPYRIGHT BAR
     Managed via page.footer_bottom region, or falls back to static line.
     ══════════════════════════════════════════════════════════════════ #}
  <div class="container-fluid copyright py-4">
    <div class="container">
      {% if page.footer_bottom %}
        {{ page.footer_bottom }}
      {% else %}
        <div class="row g-4 align-items-center">
          <div class="col-md-6 text-center text-md-start mb-md-0">
            <span class="text-white">
              <i class="fas fa-copyright text-light me-2"></i>
              <a href="{{ path('<front>') }}" class="border-bottom text-white">{{ site_name }}</a>,
              {{ 'All rights reserved.'|t }}
            </span>
          </div>
          <div class="col-md-6 text-center text-md-end">
            <span class="text-white">
              {{ 'Powered by'|t }}
              <a class="border-bottom text-white" href="https://www.drupal.org">Drupal</a>
            </span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

</footer>

{# Back-to-top button #}
<a href="#" class="btn btn-primary btn-lg-square back-to-top" aria-label="{{ 'Back to top'|t }}">
  <i class="fa fa-arrow-up"></i>
</a>

{# Toast notifications container (populated by JS) #}
<div id="toast-notification-container"
     class="toast-container position-fixed bottom-0 end-0 p-3"
     style="z-index:11000;" aria-live="polite" aria-atomic="true"></div>

{# Quick View Modal — populated by JS when "Quick View" is clicked #}
<div class="modal fade" id="quickViewModal" tabindex="-1"
     aria-labelledby="quickViewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="quickViewModalLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"
                aria-label="{{ 'Close'|t }}"></button>
      </div>
      <div class="modal-body pt-2">
        <div class="row g-4">
          <div class="col-md-5 text-center">
            <img id="qv-image" src="" alt="" class="img-fluid rounded" style="max-height:280px;object-fit:contain;">
          </div>
          <div class="col-md-7">
            <span id="qv-category" class="badge bg-primary rounded-pill px-3 py-1 mb-2 d-none"></span>
            <p    id="qv-tagline"  class="text-muted fst-italic mb-2"></p>
            <h4   id="qv-price"   class="text-primary fw-bold mb-2"></h4>
            <p    id="qv-sku"     class="text-muted small mb-3"></p>
            <p    id="qv-desc"    class="text-muted mb-4" style="font-size:.9rem;"></p>
            <a    id="qv-link"    href="#" class="btn btn-primary rounded-pill px-4 me-2">
              <i class="fas fa-shopping-bag me-2"></i>{{ 'View Full Details'|t }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{{ attach_library('commerce_theme/notifications') }}
{{ attach_library('commerce_theme/live-search') }}
{{ attach_library('commerce_theme/image-search-btn') }}
