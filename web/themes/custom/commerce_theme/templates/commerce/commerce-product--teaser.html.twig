{#
/**
 * @file
 * Product card — teaser view mode (used by product catalog view at /products).
 * price, list_price, discount set by commerce_theme_preprocess_commerce_product().
 */
#}
{% set price_str      = price ? price|commerce_price_format : '' %}
{% set list_price_str = list_price ? list_price|commerce_price_format : '' %}
{% set tagline        = product_entity.field_tagline.value %}
{% set product_url    = path('entity.commerce_product.canonical', {'commerce_product': product_entity.id()}) %}
{# cat_name is set by commerce_theme_preprocess_commerce_product() #}
{% set img_field      = product_entity.field_product_image %}
{% set img_url        = (img_field is not empty and img_field.entity)
                          ? file_url(img_field.entity.fileUri)
                          : (base_path ~ directory ~ '/images/product-1.png') %}

<div class="card h-100 border-0 shadow-sm rounded-3 product-card position-relative overflow-hidden"
     data-title="{{ product_entity.getTitle() }}"
     data-price="{{ price_str }}"
     data-image="{{ img_url }}"
     data-url="{{ product_url }}"
     data-tagline="{{ tagline }}"
     data-category="{{ cat_name }}">

  {# Image + Quick View overlay #}
  <div class="product-card__img-wrap position-relative text-center bg-light p-3"
       style="height:200px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
    <a href="{{ product_url }}">
      <img src="{{ img_url }}"
           alt="{{ product_entity.getTitle() }}"
           class="img-fluid"
           style="max-height:170px;object-fit:contain;">
    </a>
    <div class="product-card__overlay position-absolute top-0 start-0 w-100 h-100
                d-flex align-items-center justify-content-center"
         style="background:rgba(0,0,0,.45);opacity:0;transition:opacity .25s;pointer-events:none;">
      <button type="button"
              class="btn btn-light btn-sm rounded-pill px-3 fw-semibold quick-view-btn"
              style="pointer-events:auto;">
        <i class="fas fa-eye me-1"></i>{{ 'Quick View'|t }}
      </button>
    </div>
  </div>

  <div class="card-body d-flex flex-column p-3">
    {% if cat_name %}
      <span class="rounded-pill mb-1 d-inline-block"
            style="font-size:.7rem;padding:.25em .75em;background-color:#fff3e0;color:#b35900;font-weight:600;width:fit-content;">
        {{ cat_name }}
      </span>
    {% endif %}

    <h6 class="card-title fw-semibold mb-1 lh-sm" style="font-size:.9rem;">
      <a href="{{ product_url }}" class="text-dark text-decoration-none">
        {{ product_entity.getTitle() }}
      </a>
    </h6>

    {% if tagline %}
      <p class="text-muted mb-2" style="font-size:.78rem;line-height:1.3;">{{ tagline }}</p>
    {% endif %}

    <div class="mt-auto d-flex align-items-center justify-content-between gap-2 flex-wrap">
      <div>
        {% if discount > 0 %}
          <span class="badge bg-danger rounded-pill me-1" style="font-size:.65rem;">{{ discount }}% OFF</span>
        {% endif %}
        {% if price_str %}
          <span class="text-primary fw-bold fs-6 me-1">{{ price_str }}</span>
        {% endif %}
        {% if list_price_str %}
          <small class="text-muted text-decoration-line-through">{{ list_price_str }}</small>
        {% endif %}
      </div>
      <a href="{{ product_url }}"
         class="btn btn-sm btn-primary rounded-pill px-3"
         style="font-size:.78rem;">
        {{ 'View'|t }}
      </a>
    </div>
  </div>

</div>
