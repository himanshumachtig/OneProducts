{#
/**
 * @file order-detail-page.html.twig
 * Frontend order detail — timeline, items, cancel & refund actions.
 *
 * Timeline step.status values: done | active | future | error
 */
#}

{# ── Color maps ────────────────────────────────────────────────────────────── #}
{% set delivery_colors = {
  'pending':    'warning',
  'processing': 'info',
  'shipped':    'primary',
  'delivered':  'success',
  'cancelled':  'danger',
  'refunded':   'secondary',
} %}
{% set delivery_icons = {
  'pending':    'fa-clock',
  'processing': 'fa-cog fa-spin',
  'shipped':    'fa-truck',
  'delivered':  'fa-check-circle',
  'cancelled':  'fa-times-circle',
  'refunded':   'fa-undo',
} %}
{% set payment_colors = {
  'unpaid':     'warning',
  'pending':    'warning',
  'completed':  'success',
  'authorized': 'info',
  'refunded':   'secondary',
  'voided':     'danger',
} %}
{% set refund_colors = {
  'none':      'secondary',
  'requested': 'warning',
  'approved':  'success',
  'rejected':  'danger',
} %}

{% set d_color = delivery_colors[delivery_status] ?? 'secondary' %}
{% set d_icon  = delivery_icons[delivery_status]  ?? 'fa-circle' %}
{% set p_color = payment_colors[payment_status]   ?? 'secondary' %}
{% set r_color = refund_colors[refund_status]     ?? 'secondary' %}

{# ── Back link + date ───────────────────────────────────────────────────────── #}
<div class="d-flex align-items-center justify-content-between mb-4">
  <a href="{{ path('view.commerce_user_orders.order_page', {'user': order.uid.target_id}) }}"
     class="btn btn-outline-secondary btn-sm rounded-pill px-3">
    <i class="fas fa-arrow-left me-1"></i>{{ 'Back to Orders'|t }}
  </a>
  <span class="text-muted small">{{ placed_date }}</span>
</div>

{# ── Order header card ──────────────────────────────────────────────────────── #}
<div class="card border-0 bg-light rounded-3 mb-3">
  <div class="card-body p-4">
    <div class="row align-items-center g-3">
      <div class="col-sm-6">
        <h5 class="fw-bold mb-1">
          <i class="fas fa-receipt text-primary me-2"></i>
          {{ 'Order'|t }} #{{ order.orderNumber }}
        </h5>
        <p class="text-muted mb-0 small">{{ 'Placed on'|t }} {{ placed_date }}</p>
      </div>
      <div class="col-sm-6 text-sm-end">
        <span class="badge bg-{{ d_color }} rounded-pill px-3 py-2 fs-6 me-2">
          <i class="fas {{ d_icon }} me-1"></i>{{ delivery_label }}
        </span>
        {# Refund badge #}
        {% if payment_status == 'refunded' %}
          <span class="badge bg-success rounded-pill px-3 py-2 fs-6 me-1">
            <i class="fas fa-check-circle me-1"></i>{{ 'Refund Processed'|t }}
          </span>
        {% elseif refund_status == 'approved' %}
          <span class="badge bg-success rounded-pill px-3 py-2 fs-6 me-1">
            <i class="fas fa-check-circle me-1"></i>{{ 'Refund Approved'|t }}
          </span>
        {% elseif refund_status == 'requested' %}
          <span class="badge bg-warning rounded-pill px-3 py-2 fs-6 me-1">
            <i class="fas fa-hourglass-half me-1"></i>{{ 'Refund Pending'|t }}
          </span>
        {% elseif refund_status == 'rejected' %}
          <span class="badge bg-danger rounded-pill px-3 py-2 fs-6 me-1">
            <i class="fas fa-ban me-1"></i>{{ 'Refund Rejected'|t }}
          </span>
        {% endif %}
        <div class="mt-2">
          <span class="fw-bold fs-5 text-primary">{{ total }}</span>
          <span class="text-muted small ms-1">{{ 'total'|t }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Action buttons ─────────────────────────────────────────────────────────── #}
{% if can_cancel or can_refund %}
  <div class="d-flex gap-2 mb-4 flex-wrap">
    {% if can_cancel %}
      <button id="cancel-order-btn"
              class="btn btn-outline-danger btn-sm rounded-pill px-4">
        <i class="fas fa-times-circle me-1"></i>{{ 'Cancel Order'|t }}
      </button>
    {% endif %}
    {% if can_refund %}
      <button id="refund-request-btn"
              class="btn btn-outline-warning btn-sm rounded-pill px-4">
        <i class="fas fa-undo me-1"></i>{{ 'Request Refund'|t }}
      </button>
    {% endif %}
  </div>
{% endif %}

<div class="row g-4">

  {# ═══════════ LEFT COLUMN ═══════════════════════════════════════════════════ #}
  <div class="col-lg-8">

    {# ── Order Timeline ───────────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
        <h6 class="fw-bold mb-0">
          <i class="fas fa-map-marker-alt text-primary me-2"></i>{{ 'Order Timeline'|t }}
        </h6>
      </div>
      <div class="card-body px-4 pb-4">
        <div class="order-timeline">
          {% for step in timeline %}
            <div class="timeline-step {{ step.status }} {{ not loop.last ? 'has-connector' : '' }} d-flex align-items-start gap-3">
              <div class="timeline-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                   style="width:40px;height:40px;">
                <i class="fas {{ step.icon }}"></i>
              </div>
              <div class="pt-1">
                <div class="fw-semibold
                  {% if step.status == 'done' %}text-success{% endif %}
                  {% if step.status == 'active' %}text-warning{% endif %}
                  {% if step.status == 'future' %}text-muted{% endif %}
                  {% if step.status == 'error' %}text-danger{% endif %}
                ">{{ step.label }}</div>
                {% if step.time %}
                  <div class="text-muted small">{{ step.time|date('d M Y, h:i A') }}</div>
                {% elseif step.status == 'future' %}
                  <div class="text-muted small fst-italic">{{ 'Pending'|t }}</div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {# ── Admin notes ──────────────────────────────────────────────────────── #}
    {% if admin_notes %}
      <div class="card border-0 shadow-sm rounded-3 mb-4 border-start border-4 border-warning">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-2">
            <i class="fas fa-bell text-warning me-2"></i>{{ 'Order Update'|t }}
          </h6>
          <p class="mb-0 text-muted">{{ admin_notes }}</p>
        </div>
      </div>
    {% endif %}

    {# ── Refund status card ───────────────────────────────────────────────── #}
    {# Show when: payment is refunded (Commerce) OR user has any active refund request #}
    {% if payment_status == 'refunded' or refund_status in ['requested', 'approved', 'rejected'] %}
      {% if payment_status == 'refunded' %}
        {% set rc_bg = 'success' %}
        {% set rc_icon = 'fa-check-circle' %}
        {% set rc_title = 'Refund Processed'|t %}
      {% elseif refund_status == 'approved' %}
        {% set rc_bg = 'success' %}
        {% set rc_icon = 'fa-check-circle' %}
        {% set rc_title = 'Refund Approved'|t %}
      {% elseif refund_status == 'rejected' %}
        {% set rc_bg = 'danger' %}
        {% set rc_icon = 'fa-ban' %}
        {% set rc_title = 'Refund Request Rejected'|t %}
      {% else %}
        {% set rc_bg = 'warning' %}
        {% set rc_icon = 'fa-hourglass-half' %}
        {% set rc_title = 'Refund Request Pending Review'|t %}
      {% endif %}
      <div class="card border-0 shadow-sm rounded-3 mb-4 border-start border-4 border-{{ rc_bg }}">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-2 text-{{ rc_bg }}">
            <i class="fas {{ rc_icon }} me-2"></i>{{ rc_title }}
          </h6>
          {% if refund_request %}
            <p class="mb-2 small text-muted">
              <strong>{{ 'Your reason:'|t }}</strong> {{ refund_request }}
            </p>
          {% endif %}
          {% if refund_notes %}
            <p class="mb-1 small">
              <strong>{{ 'Admin response:'|t }}</strong> {{ refund_notes|striptags }}
            </p>
          {% endif %}
          {% if payment_status == 'refunded' %}
            <p class="mb-0 text-success small fw-semibold">
              <i class="fas fa-check me-1"></i>{{ 'Your refund has been processed. Amount will reflect in 3-5 business days.'|t }}
            </p>
          {% elseif refund_status == 'approved' %}
            <p class="mb-0 text-success small fw-semibold">
              <i class="fas fa-check me-1"></i>{{ 'Your refund has been approved. The amount will be credited to your account within 3-5 business days.'|t }}
            </p>
          {% elseif refund_status == 'requested' %}
            <p class="mb-0 text-muted small fst-italic mt-1">
              {{ 'We will review your request and respond within 2-3 business days.'|t }}
            </p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {# ── Order Items ──────────────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
        <h6 class="fw-bold mb-0">
          <i class="fas fa-box-open text-primary me-2"></i>{{ 'Order Items'|t }}
        </h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4 py-3" style="width:50px;"></th>
                <th class="py-3">{{ 'Product'|t }}</th>
                <th class="py-3 text-center">{{ 'Qty'|t }}</th>
                <th class="py-3 text-end">{{ 'Price'|t }}</th>
                <th class="py-3 text-end pe-4">{{ 'Total'|t }}</th>
              </tr>
            </thead>
            <tbody>
              {% for item in items %}
                <tr>
                  <td class="ps-4 py-3">
                    {% if item.image %}
                      <img src="{{ item.image }}" alt="{{ item.title }}"
                           class="rounded" style="width:48px;height:48px;object-fit:contain;background:#f8f9fa;">
                    {% else %}
                      <div class="rounded bg-light d-flex align-items-center justify-content-center"
                           style="width:48px;height:48px;">
                        <i class="fas fa-image text-muted"></i>
                      </div>
                    {% endif %}
                  </td>
                  <td class="py-3">
                    {% if item.url %}
                      <a href="{{ item.url }}" class="fw-semibold text-dark text-decoration-none">{{ item.title }}</a>
                    {% else %}
                      <span class="fw-semibold">{{ item.title }}</span>
                    {% endif %}
                  </td>
                  <td class="py-3 text-center">
                    <span class="badge bg-light text-dark rounded-pill px-2">{{ item.quantity }}</span>
                  </td>
                  <td class="py-3 text-end text-muted">{{ item.unit_price }}</td>
                  <td class="py-3 text-end pe-4 fw-semibold">{{ item.total_price }}</td>
                </tr>
              {% endfor %}
            </tbody>
            <tfoot class="table-light">
              <tr>
                <td colspan="4" class="text-end fw-bold py-3 ps-4">{{ 'Order Total'|t }}</td>
                <td class="text-end pe-4 fw-bold text-primary py-3 fs-5">{{ total }}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    {# ── Rate Your Purchase ───────────────────────────────────────────────── #}
    {% if can_rate %}
      <div class="card border-0 shadow-sm rounded-3 mt-4" id="order-rating-section">
        <div class="card-header bg-white border-0 pt-4 pb-2 px-4 d-flex align-items-center gap-2">
          <i class="fas fa-star text-warning"></i>
          <h6 class="fw-bold mb-0">{{ 'Rate Your Purchase'|t }}</h6>
        </div>
        <div class="card-body px-4 pb-4">
          <p class="text-muted small mb-3">{{ 'Share your experience! Your rating helps other shoppers.'|t }}</p>

          {% for item in items %}
            {% if item.product_id %}
              <div class="order-rating-item {% if not loop.last %}border-bottom pb-4 mb-4{% endif %}"
                   data-product-id="{{ item.product_id }}">

                {# Product info row #}
                <div class="d-flex align-items-center gap-3 mb-3">
                  {% if item.image %}
                    <img src="{{ item.image }}" alt="{{ item.title }}"
                         class="rounded" style="width:52px;height:52px;object-fit:contain;background:#f8f9fa;flex-shrink:0;">
                  {% else %}
                    <div class="rounded bg-light d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;flex-shrink:0;">
                      <i class="fas fa-box text-muted"></i>
                    </div>
                  {% endif %}
                  <div>
                    <div class="fw-semibold" style="font-size:.92rem;">{{ item.title }}</div>
                    <div class="order-rating-status mt-1" style="font-size:.8rem;">
                      {% if item.user_rating %}
                        <span class="text-success fw-semibold">
                          <i class="fas fa-check-circle me-1"></i>{{ 'Reviewed'|t }}
                        </span>
                      {% else %}
                        <span class="text-muted fst-italic">{{ 'Tap stars to rate'|t }}</span>
                      {% endif %}
                    </div>
                  </div>
                </div>

                {# Star picker #}
                <div class="order-star-picker d-flex gap-1 mb-3"
                     data-product-id="{{ item.product_id }}"
                     data-current="{{ item.user_rating }}">
                  {% for s in 1..5 %}
                    <i class="fas fa-star order-star {% if s <= item.user_rating %}rated{% endif %}"
                       data-value="{{ s }}"
                       title="{{ s }} star{{ s > 1 ? 's' : '' }}"
                       style="font-size:1.8rem;cursor:pointer;transition:transform .12s,color .12s;"></i>
                  {% endfor %}
                </div>

                {# Review text + submit (always shown; pre-filled if already reviewed) #}
                <div class="order-review-form">
                  <textarea class="form-control order-review-text mb-2"
                            rows="3"
                            placeholder="{{ 'Write your review… e.g. Great quality, very comfortable!'|t }}"
                            style="font-size:.88rem;resize:vertical;">{{ item.user_review_text }}</textarea>
                  <div class="d-flex align-items-center gap-2">
                    <button type="button"
                            class="btn btn-primary btn-sm rounded-pill px-4 order-submit-review"
                            data-product-id="{{ item.product_id }}">
                      <i class="fas fa-paper-plane me-1"></i>
                      {{ item.user_rating ? 'Update Review'|t : 'Submit Review'|t }}
                    </button>
                    <div class="order-review-msg small"></div>
                  </div>
                </div>

              </div>
            {% endif %}
          {% endfor %}

        </div>
      </div>
    {% endif %}

  </div>{# /.col-lg-8 #}

  {# ═══════════ RIGHT COLUMN ══════════════════════════════════════════════════ #}
  <div class="col-lg-4">

    {# ── Payment ──────────────────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-3">
          <i class="fas fa-credit-card text-primary me-2"></i>{{ 'Payment'|t }}
        </h6>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">{{ 'Method'|t }}</span>
          <span class="fw-semibold small">{{ payment_gateway ?: 'N/A' }}</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">{{ 'Status'|t }}</span>
          <span class="badge bg-{{ p_color }} rounded-pill px-3">{{ payment_label }}</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">{{ 'Total'|t }}</span>
          <span class="fw-bold text-primary">{{ total }}</span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">{{ 'Paid'|t }}</span>
          <span class="fw-semibold">{{ total_paid }}</span>
        </div>
      </div>
    </div>

    {# ── Delivery ─────────────────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-3">
          <i class="fas fa-truck text-primary me-2"></i>{{ 'Delivery'|t }}
        </h6>
        <div class="text-center py-2 mb-3">
          <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2 bg-{{ d_color }} bg-opacity-10"
               style="width:64px;height:64px;">
            <i class="fas {{ d_icon }} fa-2x text-{{ d_color }}"></i>
          </div>
          <div class="fw-bold text-{{ d_color }}">{{ delivery_label }}</div>
          <div class="text-muted small">{{ 'Delivery Status'|t }}</div>
        </div>
        {% if expected_delivery_date %}
          <div class="border-top pt-3 text-center">
            <div class="text-muted small mb-1">{{ 'Expected Delivery'|t }}</div>
            <div class="fw-bold text-primary">
              <i class="fas fa-calendar-alt me-1"></i>{{ expected_delivery_date }}
            </div>
          </div>
        {% elseif delivery_status not in ['delivered', 'cancelled', 'refunded'] %}
          <div class="border-top pt-3 text-center">
            <div class="text-muted small mb-1">{{ 'Expected Delivery'|t }}</div>
            <div class="text-muted small fst-italic">{{ 'To be confirmed'|t }}</div>
          </div>
        {% endif %}
      </div>
    </div>

    {# ── Billing Address ──────────────────────────────────────────────────── #}
    {% if billing %}
      <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3">
            <i class="fas fa-map-marker-alt text-primary me-2"></i>{{ 'Billing Address'|t }}
          </h6>
          <address class="mb-0 text-muted small lh-lg">
            <strong class="text-dark">{{ billing.name }}</strong><br>
            {{ billing.line1 }}{% if billing.line2 %}, {{ billing.line2 }}{% endif %}<br>
            {{ billing.city }}{% if billing.state %}, {{ billing.state }}{% endif %}{% if billing.postcode %} {{ billing.postcode }}{% endif %}<br>
            {{ billing.country }}
          </address>
        </div>
      </div>
    {% endif %}

    {# ── Order Info ───────────────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-3">
          <i class="fas fa-info-circle text-primary me-2"></i>{{ 'Order Info'|t }}
        </h6>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted small">{{ 'Order #'|t }}</span>
          <span class="fw-semibold small">{{ order.orderNumber }}</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted small">{{ 'Order State'|t }}</span>
          <span class="badge bg-{{ order_state == 'completed' ? 'success' : (order_state == 'canceled' ? 'danger' : 'warning') }} rounded-pill px-3">
            {{ order_state_label }}
          </span>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted small">{{ 'Date'|t }}</span>
          <span class="small">{{ placed_date }}</span>
        </div>
      </div>
    </div>

  </div>{# /.col-lg-4 #}

</div>{# /.row #}

{# ═══════════ CANCEL MODAL ════════════════════════════════════════════════════ #}
{% if can_cancel %}
  <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title fw-bold">
            <i class="fas fa-exclamation-triangle me-2"></i>{{ 'Cancel Order'|t }}
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <p class="mb-1">{{ 'Are you sure you want to cancel'|t }} <strong>{{ 'Order'|t }} #{{ order.orderNumber }}</strong>?</p>
          <p class="text-muted small mb-0">{{ 'This action cannot be undone. Cancelled orders cannot be reactivated.'|t }}</p>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
            {{ 'Keep Order'|t }}
          </button>
          <button type="button" id="confirm-cancel-btn" class="btn btn-danger rounded-pill px-4">
            <i class="fas fa-times-circle me-1"></i>{{ 'Yes, Cancel Order'|t }}
          </button>
        </div>
      </div>
    </div>
  </div>
{% endif %}

{# ═══════════ REFUND REQUEST MODAL ════════════════════════════════════════════ #}
{% if can_refund %}
  <div class="modal fade" id="refundModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-warning text-dark">
          <h5 class="modal-title fw-bold">
            <i class="fas fa-undo me-2"></i>{{ 'Request a Refund'|t }}
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <p class="text-muted small mb-3">
            {{ 'Please describe why you are requesting a refund. Our team will review your request within 2–3 business days.'|t }}
          </p>
          <label for="refund-reason" class="form-label fw-semibold">
            {{ 'Reason for Refund'|t }} <span class="text-danger">*</span>
          </label>
          <textarea id="refund-reason" class="form-control" rows="4"
                    placeholder="{{ 'Describe the issue with your order...'|t }}"></textarea>
          <div id="refund-reason-error" class="text-danger small mt-1 d-none"></div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
            {{ 'Cancel'|t }}
          </button>
          <button type="button" id="submit-refund-btn" class="btn btn-warning rounded-pill px-4 text-dark fw-semibold">
            <i class="fas fa-paper-plane me-1"></i>{{ 'Submit Request'|t }}
          </button>
        </div>
      </div>
    </div>
  </div>
{% endif %}
