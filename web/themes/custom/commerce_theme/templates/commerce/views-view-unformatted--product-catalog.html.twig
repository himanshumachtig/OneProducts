{#
/**
 * @file
 * Removes the views-row wrapper so Bootstrap col-* classes from the
 * product teaser are direct children of the .row.g-4 container.
 */
#}
{% if title %}
  <h3>{{ title }}</h3>
{% endif %}
{% for row in rows %}
  <div class="col-6 col-md-4 col-lg-3">
    {{ row.content }}
  </div>
{% endfor %}
