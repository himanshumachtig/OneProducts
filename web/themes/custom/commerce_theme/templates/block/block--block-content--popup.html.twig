{#
  Popup block template.
  Variables available (set in commerce_theme_preprocess_block):
    - label:           Block title set by admin in Block Layout.
    - popup_image_url: Absolute URL of the uploaded image.
    - popup_image_alt: Alt text for the image.
    - popup_link_url:  Link URL.
    - popup_link_title: Link text.
#}
<div id="site-popup" class="popup-overlay" role="dialog" aria-modal="true" aria-labelledby="popup-heading">
  <div class="popup-box">

    <button class="popup-close-btn" type="button" aria-label="{{ 'Close popup'|t }}">
      &times;
    </button>

    {% if popup_image_url %}
      <div class="popup-image">
        <img src="{{ popup_image_url }}" alt="{{ popup_image_alt }}" loading="eager">
      </div>
    {% endif %}

    <div class="popup-body">
      {% if label %}
        <h3 class="popup-title" id="popup-heading">{{ label }}</h3>
      {% endif %}

      {% if popup_link_url %}
        <div class="popup-cta">
          <a href="{{ popup_link_url }}">{{ popup_link_title }}</a>
        </div>
      {% endif %}
    </div>

  </div>
</div>
