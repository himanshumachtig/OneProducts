{#
/**
 * @file
 * Unformatted rows for homepage_category_products view (both embed displays).
 * Wraps product cards in a Bootstrap responsive grid.
 */
#}
<div class="row g-4">
  {% for row in rows %}
    <div class="col-6 col-md-4 col-lg-3">
      {{ row.content }}
    </div>
  {% endfor %}
</div>
